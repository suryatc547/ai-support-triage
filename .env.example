# Copy this file to `.env` in the repo root and fill in your real values.
# `.env` is gitignored and must never be committed.

# IMAP mailbox settings
IMAP_EMAIL=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_HOST=imap.gmail.com
IMAP_FOLDER=inbox

# Google Gemini API key for ticket classification
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-1.5-pro

# Fallback LLM providers (optional; only used if Gemini is unavailable).
# OpenRouter fallback
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq fallback
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Security guardrails (optional; sensible defaults shipped in code).
# Comma-separated lists. Override only when your environment differs.
# SECURITY_TRUSTED_DOMAINS=gmail.com,outlook.com
# SECURITY_DISPOSABLE_DOMAINS=
# SECURITY_SPAM_DOMAINS=sendspamhere.com,mailforspam.com,spamgourmet.com
# SECURITY_MAX_ATTACHMENT_BYTES=26214400
# SECURITY_MAX_ATTACHMENT_COUNT=10
# SECURITY_SUSPICION_THRESHOLD=45
