{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/*.env": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny"
    },
    "bash": {
      "cat .env*": "deny",
      "type .env*": "deny",
      "Get-Content .env*": "deny",
      "Get-Content -Path *\\.env*": "deny",
      "*": "allow"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny"
    }
  }
}
