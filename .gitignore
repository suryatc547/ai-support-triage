*.sqlite3

# ============================================================
# Local Model & ML Artifacts (modelm/)
# ============================================================
# NOTE: modelm/weights.json and modelm/metrics.json are INTENTIONALLY TRACKED —
# they are small, re-training only needs a few seconds, and committing them makes
# the shipped classifier reproducible without a training step at deploy time.
# Only heavy or throwaway model artifacts are ignored below.
# Ignore heavy weights, raw checkpoints, ONNX/PyTorch models if tested
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
modelm/checkpoints/
modelm/cache/
modelm/tmp/
modelm/*_checkpoint.json

# ============================================================
# Node.js / Frontend (web/)
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite build output
web/dist/
web/.vite/
.vite/

# pnpm
.pnpm-store/

# TypeScript build info
*.tsbuildinfo

